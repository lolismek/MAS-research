# Copy this to `.env` at the repo root and fill in. `.env` is gitignored.
# Consumed by: shared/proxy/server.py and chatdev/judging/judge/judge.py
# (both auto-load the repo-root .env).

# Perplexity API key — proxy upstream (serves gpt-5.4-mini via /v1/responses)
# AND the MAST judge (openai/gpt-5.5 via Perplexity Responses API). Required.
PERPLEXITY_API_KEY=

# OpenAI API key — only for the proxy's /o/ (OpenAI-direct) route that the
# AutoGen split4_openai batch used to capture reasoning summaries. Optional.
OPENAI_API_KEY=

# Anthropic API key — optional; not required to reproduce any of the 3 MAS.
ANTHROPIC_API_KEY=

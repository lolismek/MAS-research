## `gui.py`

```python
'''
Tkinter GUI for the Connect Four game.
'''

import tkinter as tk
from tkinter import messagebox

from game import ConnectFourGame, PLAYER_ONE, PLAYER_TWO, EMPTY


class ConnectFourGUI:
    """Graphical user interface for Connect Four."""

    def __init__(self):
        self.game = ConnectFourGame()
        self.root = tk.Tk()
        self.root.title("Connect Four")
        self.root.resizable(False, False)

        self.cell_size = 80
        self.padding = 20
        self.width = self.game.columns * self.cell_size + self.padding * 2
        self.height = self.game.rows * self.cell_size + self.padding * 2 + 120

        self.root.geometry(f"{self.width}x{self.height}")

        self.status_var = tk.StringVar()
        self.status_var.set("Player 1's turn (Red)")

        self._build_ui()
        self._draw_board()

    def _build_ui(self):
        """Create widgets and layout."""
        top_frame = tk.Frame(self.root)
        top_frame.pack(pady=10)

        tk.Label(top_frame, text="Choose a column (1-7):").pack(side=tk.LEFT, padx=(0, 8))

        self.column_entry = tk.Entry(top_frame, width=5, justify="center")
        self.column_entry.pack(side=tk.LEFT)
        self.column_entry.bind("<Return>", self._on_drop)

        drop_button = tk.Button(top_frame, text="Drop Disc", command=self._on_drop)
        drop_button.pack(side=tk.LEFT, padx=8)

        reset_button = tk.Button(top_frame, text="Reset Game", command=self._reset_game)
        reset_button.pack(side=tk.LEFT)

        tk.Label(self.root, textvariable=self.status_var, font=("Arial", 12, "bold")).pack(pady=5)

        self.canvas = tk.Canvas(
            self.root,
            width=self.game.columns * self.cell_size,
            height=self.game.rows * self.cell_size,
            bg="#1E3A8A",
            highlightthickness=0
        )
        self.canvas.pack(padx=self.padding, pady=(0, 10))

    def run(self):
        """Start the Tkinter event loop."""
        self.root.mainloop()

    def _reset_game(self):
        """Reset the board and refresh the UI."""
        self.game.reset()
        self.status_var.set("Player 1's turn (Red)")
        self._draw_board()

    def _on_drop(self, event=None):
        """Handle drop action from button or Enter key."""
        text = self.column_entry.get().strip()

        if not text.isdigit():
            messagebox.showerror("Invalid Input", "Please enter a number from 1 to 7.")
            return

        column_number = int(text)
        column_index = column_number - 1

        success, message = self.game.drop_piece(column_index)
        if not success:
            messagebox.showerror("Invalid Move", message)
            return

        self._draw_board()

        if self.game.game_over:
            self.status_var.set(message)
            if self.game.winner is not None:
                winner_color = "Red" if self.game.winner == PLAYER_ONE else "Yellow"
                messagebox.showinfo("Game Over", f"{message}\n{winner_color} wins!")
            else:
                messagebox.showinfo("Game Over", message)
        else:
            player_text = "Player 1's turn (Red)" if self.game.current_player == PLAYER_ONE else "Player 2's turn (Yellow)"
            self.status_var.set(player_text)

        self.column_entry.delete(0, tk.END)

    def _draw_board(self):
        """Render the board and pieces on the canvas."""
        self.canvas.delete("all")

        for row in range(self.game.rows):
            for col in range(self.game.columns):
                x1 = col * self.cell_size
                y1 = row * self.cell_size
                x2 = x1 + self.cell_size
                y2 = y1 + self.cell_size

                self.canvas.create_rectangle(x1, y1, x2, y2, fill="#1E3A8A", outline="#0F172A", width=2)

                piece = self.game.board[row][col]
                if piece == EMPTY:
                    color = "#E5E7EB"
                elif piece == PLAYER_ONE:
                    color = "#EF4444"
                else:
                    color = "#FACC15"

                pad = 10
                self.canvas.create_oval(
                    x1 + pad, y1 + pad, x2 - pad, y2 - pad,
                    fill=color, outline="#111827"
                )
```


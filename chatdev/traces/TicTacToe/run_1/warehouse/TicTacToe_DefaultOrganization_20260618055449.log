        if b[0][0] == b[1][1] == b[2][2] == p:
            return True
        if b[0][2] == b[1][1] == b[2][0] == p:
            return True

        return False

    def is_draw(self):
        '''
        Return True if the board is full and there is no winner.
        '''
        for row in self.board:
            for cell in row:
                if cell == "":
                    return False
        return self.winner is None



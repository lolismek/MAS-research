            self.canvas_height // 2 - 50,
            self.canvas_width - 20,
            self.canvas_height // 2 + 50,
            fill="#000000",
            stipple="gray50",
            outline="#ffffff",
            width=2,
        )
        self.canvas.create_text(
            self.canvas_width // 2,
            self.canvas_height // 2 - 10,
            text="Game Over",
            fill="white",
            font=("Arial", 20, "bold"),
        )
        self.canvas.create_text(
            self.canvas_width // 2,
            self.canvas_height // 2 + 20,

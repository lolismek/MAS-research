## File: `game_ui.py`

```python
'''
Tkinter user interface for the Match-3 game.
'''

from __future__ import annotations

import tkinter as tk
from tkinter import messagebox
from typing import TYPE_CHECKING, Dict, Tuple

if TYPE_CHECKING:
    from game_controller import GameController


class GameUI:
    """Tkinter GUI for the match-3 game."""

    COLORS: Dict[int, str] = {
        1: "#ff4d4d",  # red
        2: "#ffb84d",  # orange
        3: "#ffff66",  # yellow
        4: "#66e066",  # green
        5: "#66b3ff",  # blue
        6: "#cc66ff",  # purple
        7: "#ff66b2",  # pink
        8: "#8c8c8c",  # gray
    }

    def __init__(
        self,
        controller: "GameController",
        rows: int,
        cols: int,
        cell_size: int = 64,
        target_score: int = 2000,
    ) -> None:
        self.controller = controller
        self.rows = rows
        self.cols = cols
        self.cell_size = cell_size
        self.target_score = target_score

        self.root = tk.Tk()
        self.root.title("Match-3 Puzzle Game")

        board_width = cols * cell_size
        board_height = rows * cell_size

        top = tk.Frame(self.root)
        top.pack(side=tk.TOP, fill=tk.X)

        self.score_var = tk.StringVar(value="Score: 0")
        self.moves_var = tk.StringVar(value="Moves Left: 0")
        self.status_var = tk.StringVar(value="Ready")

        tk.Label(top, textvariable=self.score_var, font=("Arial", 14, "bold")).pack(
            side=tk.LEFT, padx=10, pady=8
        )
        tk.Label(top, textvariable=self.moves_var, font=("Arial", 14, "bold")).pack(
            side=tk.LEFT, padx=10, pady=8
        )
        tk.Label(
            top,
            text=f"Target: {self.target_score}",
            font=("Arial", 14, "bold"),
        ).pack(side=tk.LEFT, padx=10, pady=8)

        self.canvas = tk.Canvas(
            self.root,
            width=board_width,
            height=board_height,
            bg="#1f1f1f",
            highlightthickness=0,
        )
        self.canvas.pack(padx=10, pady=10)

        bottom = tk.Frame(self.root)
        bottom.pack(side=tk.BOTTOM, fill=tk.X)

        self.status_label = tk.Label(
            bottom, textvariable=self.status_var, font=("Arial", 12)
        )
        self.status_label.pack(side=tk.LEFT, padx=10, pady=8)

        tk.Button(bottom, text="New Game", command=self.controller.start_new_game).pack(
            side=tk.RIGHT, padx=10
        )
        tk.Button(bottom, text="Quit", command=self.root.destroy).pack(
            side=tk.RIGHT, padx=10
        )

        self.canvas.bind("<Button-1>", self.on_canvas_click)

    def run(self) -> None:
        self.root.mainloop()

    def on_canvas_click(self, event: tk.Event) -> None:
        row = event.y // self.cell_size
        col = event.x // self.cell_size
        if 0 <= row < self.rows and 0 <= col < self.cols:
            self.controller.on_cell_click(row, col)

    def update_hud(self, score: int, moves_left: int) -> None:
        self.score_var.set(f"Score: {score}")
        self.moves_var.set(f"Moves Left: {moves_left}")

    def set_status(self, text: str) -> None:
        self.status_var.set(text)

    def render(self) -> None:
        self.canvas.delete("all")
        board = self.controller.board
        selected = self.controller.selected

        for r in range(self.rows):
            for c in range(self.cols):
                x1 = c * self.cell_size
                y1 = r * self.cell_size
                x2 = x1 + self.cell_size
                y2 = y1 + self.cell_size

                candy = board.grid[r][c]
                color = self.COLORS.get(candy, "#ffffff")

                self.canvas.create_rectangle(
                    x1, y1, x2, y2,
                    fill=color,
                    outline="#333333",
                    width=2,
                )

                # Highlight selection
                if selected == (r, c):
                    self.canvas.create_rectangle(
                        x1 + 3, y1 + 3, x2 - 3, y2 - 3,
                        outline="white",
                        width=4,
                    )

                # Candy label
                self.canvas.create_text(
                    (x1 + x2) / 2,
                    (y1 + y2) / 2,
                    text=str(candy),
                    fill="black",
                    font=("Arial", 16, "bold"),
                )

        self.root.update_idletasks()

    def show_game_over(self, message: str) -> None:
        messagebox.showinfo("Game Over", message)
```

## How to run

Save the files in the same folder:

- `main.py`
- `game_controller.py`
- `board.py`
- `game_ui.py`

Then run:

```bash
python main.py
```

## Notes
- Candies are represented by numbered colored tiles.
- A move is only valid if the swap creates a match.
- Chain reactions are supported automatically.
- The game includes both a **move limit** and a **target score** win condition.

If you want, I can also provide:
1. an **animated version** with smooth falling/swapping using Pygame, or  
2. a **more polished tkinter version** with images, sound effects, and move-timer mode.


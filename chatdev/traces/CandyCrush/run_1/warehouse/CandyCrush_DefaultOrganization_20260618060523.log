oves or time-based constraints.', 'modality': 'application', 'ideas': '', 'language': ' Python', 'codes': 'main.py\npython\n\'\'\'\nMain entry point for the Match-3 puzzle game.\n\'\'\'\nfrom game_controller import GameController\ndef main() -&gt; None:\n    """Start the game application."""\n    game = GameController()\n    game.run()\nif __name__ == "__main__":\n    main()\n\n\ngame_controller.py\npython\n\'\'\'\nGame controller for the Match-3 puzzle game.\nCoordinates the board model and GUI interactions.\n\'\'\'\nfrom __future__ import annotations\nfrom dataclasses import dataclass\nfrom typing import Optional, Tuple\nfrom board import Match3Board\nfrom game_ui import GameUI\n@dataclass\nclass GameConfig:\n    rows: int = 8\n    cols: int = 8\n    candy_types: int = 6\n    cell_size: int = 64\n    moves_limit: int = 30\n    target_score: int = 2000\nclass GameController:\n    """Main controller that manages game state and user interaction."""\n    def __init__(self) -&gt; None:\n        self.config = GameConfig()\n        self.board = Match3Board(\n            rows=self.config.rows,\n            cols=self.config.cols,\n            candy_types=self.config.candy_types,\n        )\n        self.score = 0\n        self.moves_left = self.config.moves_limit\n        self.selected: Optional[Tuple[int, int]] = None\n        self.game_over = False\n        self.ui = GameUI(\n            controller=self,\n            rows=self.config.rows,\n            cols=self.config.cols,\n            cell_size=self.config.cell_size,\n            target_score=self.config.target_score,\n        )\n        self.start_new_game()\n    def run(self) -&gt; None:\n        """Run the tkinter main loop."""\n        self.ui.run()\n    def start_new_game(self) -&gt; None:\n        """Reset the board and game state."""\n        self.board.reset()\n        self.score = 0\n        self.moves_left = self.config.moves_limit\n        self.selected = None\n        self.game_over = False\n        self.ui.set_status("Match candies to score points!")\n        self.ui.update_hud(self.score, self.moves_left)\n        self.ui.render()\n    def on_cell_click(self, row: int, col: int) -&gt; None:\n        """Handle a click on a board cell."""\n        if self.game_over:\n            return\n        if self.moves_left &lt;= 0:\n            self.end_game("No moves left. Game over!")\n            return\n        if self.selected is None:\n            self.selected = (row, col)\n            self.ui.render()\n            return\n        sr, sc = self.selected\n        if (sr, sc) == (row, col):\n            self.selected = None\n            self.ui.render()\n            return\n        if self.board.are_adjacent(sr, sc, row, col):\n            valid, gained = self.board.try_swap_and_resolve(sr, sc, row, col)\n            self.selected = None\n            if valid:\n                self.moves_left -= 1\n                self.score += gained\n                self.ui.set_status(f"Cleared {gained} candies! Keep going.")\n                self.ui.update_hud(self.score, self.moves_left)\n                self.ui.render()\n                if self.score &gt;= self.config.target_score:\n                    self.end_game("You reached the target score. You win!")\n                    return\n                if self.moves_left &lt;= 0:\n                    self.end_game("No moves left. Game over!")\n                    return\n                if not self.board.has_any_valid_move():\n                    self.end_game("No valid moves remain. Game over!")\n                    return\n            else:\n                self.ui.set_status("Invalid move: swap must create a match.")\n                self.ui.render()\n        else:\n            self.selected = (row, col)\n            self.ui.render()\n    def end_game(self, message: str) -&gt; None:\n        """End the game and show a final message."""\n        self.game_over = True\n        self.ui.set_status(message)\n        self.ui.render()\n        self.ui.show_game_over(message)\n\n\nboard.py\npython\n\'\'\'\nBoard model and match-3 logic.\n\'\'\'\nfrom __future__ import annotations\nimport random\nfrom typing import List, Set, Tuple\nCandy = int\nPosition = Tuple[int, int]\nclass Match3Board:\n    """Represents the logical match-3 board and game mechanics."""\n    def __init__(self, rows: int = 8, cols: int = 8, candy_types: int = 6) -&gt; None:\n        self.rows = rows\n        self.cols = cols\n        self.candy_types = candy_types\n        self.grid: List[List[Candy]] = []\n        self.reset()\n    def reset(self) -&gt; None:\n        """Create a new random board with no initial matches."""\n        self.grid = [[self._random_candy() for _ in range(self.cols)] for _ in range(self.rows)]\n        while self.find_matches():\n            self._remove_initial_matches()\n    def _random_candy(self) -&gt; Candy:\n        return random.randint(1, self.candy_types)\n    def _remove_initial_matches(self) -&gt; None:\n        matches = self.find_matches()\n        for r, c in matches:\n            self.grid[r][c] = self._random_candy()\n    def in_bounds(self, row: int, col: int) -&gt; bool:\n        return 0 &lt;= row &lt; self.rows and 0 &lt;= col &lt; self.cols\n    def are_adjacent(self, r1: int, c1: int, r2: int, c2: int) -&gt; bool:\n        return abs(r1 - r2) + abs(c1 - c2) == 1\n    def swap(self, r1: int, c1: int, r2: int, c2: int) -&gt; None:\n        self.grid[r1][c1], self.grid[r2][c2] = self.grid[r2][c2], self.grid[r1][c1]\n    def find_matches(self) -&gt; Set[Position]:\n        """Find all cells that belong to 3+ horizontal or vertical matches."""\n        matched: Set[Position] = set()\n        for r in range(self.rows):\n            c = 0\n            while c &lt; self.cols:\n                start = c\n                candy = self.grid[r][c]\n                if candy == 0:\n                    c += 1\n                    continue\n                while c + 1 &lt; self.cols and self.grid[r][c + 1] == candy:\n                    c += 1\n                length = c - start + 1\n                if length &gt;= 3:\n                    for cc in range(start, c + 1):\n                        matched.add((r, cc))\n                c += 1\n        for c in range(self.cols):\n            r = 0\n            while r &lt; self.rows:\n                start = r\n                candy = self.grid[r][c]\n                if candy == 0:\n                    r += 1\n                    continue\n                while r + 1 &lt; self.rows and self.grid[r + 1][c] == candy:\n                    r += 1\n                length = r - start + 1\n                if length &gt;= 3:\n                    for rr in range(start, r + 1):\n                        matched.add((rr, c))\n                r += 1\n        return matched\n    def clear_matches(self, matches: Set[Position]) -&gt; int:\n        """Clear matched candies by setting them to 0; return number cleared."""\n        for r, c in matches:\n            self.grid[r][c] = 0\n        return len(matches)\n    def collapse(self) -&gt; None:\n        """Apply gravity so candies fall down into empty spaces."""\n        for c in range(self.cols):\n            column = [self.grid[r][c] for r in range(self.rows) if self.grid[r][c] != 0]\n            missing = self.rows - len(column)\n            new_column = [0] * missing + column\n            for r in range(self.rows):\n                self.grid[r][c] = new_column[r]\n    def refill(self) -&gt; None:\n        """Fill empty spaces with new random candies."""\n        for r in range(self.rows):\n            for c in range(self.cols):\n                if self.grid[r][c] == 0:\n                    self.grid[r][c] = self._random_candy()\n    def resolve_board(self) -&gt; int:\n        """\n        Resolve all cascading matches:\n        clear matches, collapse, refill, repeat.\n        Returns the total score gained from all cleared candies.\n        """\n        total_cleared = 0\n        while True:\n            matches = self.find_matches()\n            if not matches:\n                break\n            total_cleared += self.clear_matches(matches)\n            self.collapse()\n            self.refill()\n        return total_cleared\n    def try_swap_and_resolve(self, r1: int, c1: int, r2: int, c2: int) -&gt; Tuple[bool, int]:\n        """\n        Attempt a swap. If it creates a match, keep it and resolve cascades.\n        Returns (valid_move, score_gained).\n        """\n        self.swap(r1, c1, r2, c2)\n        initial_matches = self.find_matches()\n        if not initial_matches:\n            self.swap(r1, c1, r2, c2)\n            return False, 0\n        gained = self.clear_matches(initial_matches)\n        self.collapse()\n        self.refill()\n        gained += self.resolve_board()\n        return True, gained\n    def has_any_valid_move(self) -&gt; bool:\n        """Check whether any adjacent swap can produce a match."""\n        for r in range(self.rows):\n            for c in range(self.cols):\n                if c + 1 &lt; self.cols:\n                    self.swap(r, c, r, c + 1)\n                    if self.find_matches():\n                        self.swap(r, c, r, c + 1)\n                        return True\n                    self.swap(r, c, r, c + 1)\n                if r + 1 &lt; self.rows:\n                    self.swap(r, c, r + 1, c)\n                    if self.find_matches():\n                        self.swap(r, c, r + 1, c)\n                        return True\n                    self.swap(r, c, r + 1, c)\n        return False\n\n\ngame_ui.py\npython\n\'\'\'\nTkinter-based user interface for the Match-3 puzzle game.\n\'\'\'\nfrom __future__ import annotations\nimport tkinter as tk\nfrom typing import TYPE_CHECKING, Dict, Tuple\nif TYPE_CHECKING:\n    from game_controller import GameController\nclass GameUI:\n    """Graphical user interface for rendering the board and handling user input."""\n    def __init__(\n        self,\n        controller: "GameController",\n        rows: int,\n        cols: int,\n        cell_size: int,\n        target_score: int,\n    ) -&gt; None:\n        self.controller = controller\n        self.rows = rows\n        self.cols = cols\n        self.cell_size = cell_size\n        self.target_score = target_score\n        self.window = tk.Tk()\n        self.window.title("Match-3 Puzzle Game")\n        self.window.resizable(False, False)\n        self.colors: Dict[int, str] = {\n            0: "#ffffff",\n            1: "#ff6b6b",\n            2: "#ffd93d",\n            3: "#6bcB77",\n            4: "#4d96ff",\n            5: "#b983ff",\n            6: "#ff9f1c",\n            7: "#00c2a8",\n            8: "#ff66c4",\n        }\n        self.canvas_width = self.cols * self.cell_size\n        self.canvas_height = self.rows * self.cell_size\n        self.hud_frame = tk.Frame(self.window, padx=10, pady=10)\n        self.hud_frame.pack(fill=tk.X)\n        self.score_var = tk.StringVar(value="Score: 0")\n        self.moves_var = tk.StringVar(value="Moves Left: 0")\n        self.target_var = tk.StringVar(value=f"Target: {self.target_score}")\n        self.status_var = tk.StringVar(value="")\n        self.score_label = tk.Label(self.hud_frame, textvariable=self.score_var, font=("Arial", 12, "bold"))\n        self.moves_label = tk.Label(self.hud_frame, textvariable=self.moves_var, font=("Arial", 12, "bold"))\n        self.target_label = tk.Label(self.hud_frame, textvariable=self.target_var, font=("Arial", 12, "bold"))\n        self.score_label.grid(row=0, column=0, padx=8)\n        self.moves_label.grid(row=0, column=1, padx=8)\n        self.target_label.grid(row=0, column=2, padx=8)\n        self.status_label = tk.Label(self.window, textvariable=self.status_var, anchor="w", padx=10)\n        self.status_label.pack(fill=tk.X)\n        self.canvas = tk.Canvas(\n            self.window,\n            width=self.canvas_width,\n            height=self.canvas_height,\n            bg="#f5f5f5",\n            highlightthickness=0,\n        )\n        self.canvas.pack(padx=10, pady=10)\n        self.canvas.bind("&lt;Button-1&gt;", self._on_canvas_click)\n        self._game_over_overlay = None\n    def run(self) -&gt; None:\n        """Start the Tkinter event loop."""\n        self.window.mainloop()\n    def set_status(self, message: str) -&gt; None:\n        """Update the status message shown below the HUD."""\n        self.status_var.set(message)\n    def update_hud(self, score: int, moves_left: int) -&gt; None:\n        """Update score and moves labels."""\n        self.score_var.set(f"Score: {score}")\n        self.moves_var.set(f"Moves Left: {moves_left}")\n    def render(self) -&gt; None:\n        """Redraw the entire board."""\n        self.canvas.delete("all")\n        board = self.controller.board.grid\n        selected = self.controller.selected\n        for r in range(self.rows):\n            for c in range(self.cols):\n                x1 = c * self.cell_size\n                y1 = r * self.cell_size\n                x2 = x1 + self.cell_size\n                y2 = y1 + self.cell_size\n                candy = board[r][c]\n                fill = self.colors.get(candy, "#cccccc")\n                outline = "#333333"\n                width = 1\n                if selected == (r, c):\n                    outline = "#000000"\n                    width = 4\n                self.canvas.create_rectangle(x1, y1, x2, y2, fill=fill, outline=outline, width=width)\n                if candy != 0:\n                    pad = 10\n                    self.canvas.create_oval(\n                        x1 + pad,\n                        y1 + pad,\n                        x2 - pad,\n                        y2 - pad,\n                        fill=fill,\n                        outline="#ffffff",\n                        width=2,\n                    )\n        for r in range(self.rows + 1):\n            y = r * self.cell_size\n            self.canvas.create_line(0, y, self.canvas_width, y, fill="#dddddd")\n        for c in range(self.cols + 1):\n            x = c * self.cell_size\n            self.canvas.create_line(x, 0, x, self.canvas_height, fill="#dddddd")\n    def show_game_over(self, message: str) -&gt; None:\n        """Display a game-over overlay with the final message."""\n        if self._game_over_overlay is not None:\n            self.canvas.delete(self._game_over_overlay)\n            self._game_over_overlay = None\n        self._game_over_overlay = self.canvas.create_rectangle(\n            20, self.canvas_height // 2 - 50, self.canvas_width - 20, self.canvas_height // 2 + 50,\n            fill="#000000",\n            stipple="gray50",\n            outline="#ffffff",\n            width=2,\n        )\n        self.canvas.create_text(\n            self.canvas_width // 2,\n            self.canvas_height // 2 - 10,\n            text="Game Over",\n            fill="white",\n            font=("Arial", 20, "bold"),\n        )\n        self.canvas.create_text(\n            self.canvas_width // 2,\n            self.canvas_height // 2 + 20,\n            text=message,\n            fill="white",\n            font=("Arial", 12),\n        )\n    def _on_canvas_click(self, event: tk.Event) -&gt; None:\n        """Convert mouse clicks to board coordinates."""\n        row = event.y // self.cell_size\n        col = event.x // self.cell_size\n        if 0 &lt;= row &lt; self.rows and 0 &lt;= col &lt; self.cols:\n            self.controller.on_cell_click(int(row), int(col))\n\n\n', 'images': '', 'comments': '\nHighest-priority issue: GameController.__init__() calls self.start_new_game() before the Tkinter UI has fully finished initializing, and start_new_game() immediately calls self.ui.render(). This can break startup or create unstable behavior if GameUI is not fully ready or if future UI init changes occur. Also, the current code does not guarantee that the board has a valid post-start state before first render beyond the constructor’s random reset loop, and the game-over overlay is never cleared when starting a new game.\n\n\n\nFix the startup flow so UI initialization and first render happen in a safe, explicit order:\n\n1. In GameController.__init__, create the UI first, then call start_new_game() only after UI is fully constructed.\n2. In GameUI, add a method like clear_game_over_overlay() and call it from start_new_game() before rendering.\n3. Ensure start_new_game() resets the board, status, HUD, selection, and any overlay state in one place.\n4. Optionally defer first render until after the Tk window is fully ready using window.after(0, ...) or call render() only from run() after setup.\n\nSuggested patch outline:\npython\n# game_controller.py\ndef __init__(self) -&gt; None:\n    self.config = GameConfig()\n    self.score = 0\n    self.moves_left = self.config.moves_limit\n    self.selected = None\n    self.game_over = False\n    self.board = Match3Board(...)\n    self.ui = GameUI(...)\n    self.start_new_game()\n\n\npython\n# game_ui.py\ndef clear_game_over_overlay(self) -&gt; None:\n    if self._game_over_overlay is not None:\n        self.canvas.delete(self._game_over_overlay)\n        self._game_over_overlay = None\n\n\npython\n# game_controller.py\ndef start_new_game(self) -&gt; None:\n    self.board.reset()\n    self.score = 0\n    self.moves_left = self.config.moves_limit\n    self.selected = None\n    self.game_over = False\n    self.ui.clear_game_over_overlay()\n    self.ui.set_status("Match candies to score points!")\n    self.ui.update_hud(self.score, self.moves_left)\n    self.ui.render()\n\n\n\n\nOther important review points:\n- has_any_valid_move() mutates the board repeatedly and relies on swapping back; it works, but it is brittle. A safer approach is to inspect potential swaps on a copied board.\n- resolve_board() may generate new matches after refill, which is correct, but try_swap_and_resolve() only checks the immediate swap match before clearing. That is okay for match-3, but if you want classic Candy Crush behavior, consider showing/animating each cascade step.\n- The scoring currently equals number of cleared candies; if you want more game-like progression, add combo multipliers for chain reactions.\n- Time-based constraints are not implemented yet, only move limits are. If the task requires time mode, add a countdown timer in the controller/UI.\n'} |

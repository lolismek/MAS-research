# secrets
.env
*.env
!.env.example

# python
__pycache__/
*.pyc
*.pyo

# proxy runtime logs (accumulating; regenerate per run, read by metrics/cost.py)
shared/proxy/calls.jsonl
shared/proxy/raw_calls.jsonl

# benchmark task data: derived + reproducible via benchmarks/<name>/prep.py.
# Kept out of git so gated content (GPQA-Diamond) isn't redistributed, and to avoid bloat.
benchmarks/*/tasks.jsonl

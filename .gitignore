# secrets
.env
*.env
!.env.example

# python
__pycache__/
*.pyc
*.pyo

# proxy runtime logs (accumulating; regenerate per run, read by metrics/cost.py)
shared/proxy/calls.jsonl
shared/proxy/raw_calls.jsonl

# benchmark task data: derived + reproducible via benchmarks/<name>/prep.py.
# Kept out of git so gated content (GPQA-Diamond, GAIA) isn't redistributed, and to avoid bloat.
benchmarks/*/tasks.jsonl
# FanOutQA raw dev split (1.1MB): prep.py re-downloads it from the fanoutqa repo on demand.
benchmarks/fanoutqa/fanout-final-dev.json
# GAIA gated derivatives: staged attachments + the excluded vision/media task records.
benchmarks/gaia/files/
benchmarks/gaia/excluded_vision.jsonl

# Traces are regenerable run outputs (the harness auto-resumes) and a partial slice anyway
# (gated GPQA-Diamond/GAIA must stay out — their traces embed the verbatim question), so
# keep ALL of them out of git. RESULTS.md (aggregates via agg.py, no verbatim questions)
# is the committed, shareable artifact. The viewer reads traces from disk locally.
camel/traces/

# stray artifacts downloaded by GAIA run_python tasks (e.g. a 4MB English word list)
words_alpha.txt

# macnet run outputs (regenerated per run): per-episode .db logs + empty logs dir +
# viewer trace store (ingest.py rebuilds it from .db + tagged proxy calls; viewer reads it locally)
macnet/.db/
macnet/logs/
macnet/traces/

# dylan run outputs (regenerated per run): per-episode .db logs + empty logs dir
dylan/.db/
dylan/logs/

# duet trace viewer: build.py regenerates it from duet/traces/ locally (2.9MB, changes
# every rebuild). The generator is committed; the rendered page is not.
duet/viewer/index.html

# alfworld dataset (downloaded, ~2.2GB / 18k files): game JSON (json_2.1.1/) + the
# Mask-RCNN detector checkpoint (detectors/) + PDDL logic. Re-downloadable, kept out of
# git to avoid bloat. Only alfworld_tasks_suffix.json (the committed task list) is tracked.
macnet/data/alfworld/*
!macnet/data/alfworld/alfworld_tasks_suffix.json

# dylan alfworld dataset: same ~2.2GB / 18k-file payload as macnet's (game JSON json_2.1.1/,
# the Mask-RCNN detector checkpoint detectors/, PDDL logic logic/). Symlinked to macnet's copy
# to avoid a duplicate download; re-downloadable, kept out of git to avoid bloat. Only
# alfworld_tasks_suffix.json (the committed task list) is tracked.
dylan/data/alfworld/*
!dylan/data/alfworld/alfworld_tasks_suffix.json

# duet sweep per-job worker logs (1 file per run, 7MB+; pure subprocess stdout, regenerable).
# The committed duet/sweeps/<sweep>/sweep.log is the master journal (phases, outcomes, spend).
duet/sweeps/*/logs/

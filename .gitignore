# secrets
.env
*.env
!.env.example

# python
__pycache__/
*.pyc
*.pyo

# proxy runtime logs (accumulating; regenerate per run, read by metrics/cost.py)
shared/proxy/calls.jsonl
shared/proxy/raw_calls.jsonl

# benchmark task data: derived + reproducible via benchmarks/<name>/prep.py.
# Kept out of git so gated content (GPQA-Diamond, GAIA) isn't redistributed, and to avoid bloat.
benchmarks/*/tasks.jsonl
# GAIA gated derivatives: staged attachments + the excluded vision/media task records.
benchmarks/gaia/files/
benchmarks/gaia/excluded_vision.jsonl

# Traces are regenerable run outputs (the harness auto-resumes) and a partial slice anyway
# (gated GPQA-Diamond/GAIA must stay out — their traces embed the verbatim question), so
# keep ALL of them out of git. RESULTS.md (aggregates via agg.py, no verbatim questions)
# is the committed, shareable artifact. The viewer reads traces from disk locally.
camel/traces/

# stray artifacts downloaded by GAIA run_python tasks (e.g. a 4MB English word list)
words_alpha.txt

# macnet run outputs (regenerated per run): per-episode .db logs + empty logs dir
macnet/.db/
macnet/logs/

# dylan run outputs (regenerated per run): per-episode .db logs + empty logs dir
dylan/.db/
dylan/logs/

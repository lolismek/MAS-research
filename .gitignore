# eval-clean — consolidated 3-MAS benchmark
#
# IMPORTANT: do NOT add a blanket `traces/` or `runs/` rule here. Raw traces are
# COMMITTED on purpose — a prior setup gitignored the run dirs and the ChatDev
# traces were permanently lost. Only true regenerables, secrets, and external
# code clones are ignored below.

# ---- Secrets (.env.example IS tracked; it holds placeholders only) ----
.env
*.env

# ---- Python ----
__pycache__/
*.py[cod]

# proxy runtime logs (accumulating; regenerate per run, read by metrics/cost.py)
shared/proxy/calls.jsonl
shared/proxy/raw_calls.jsonl

# benchmark task data: derived + reproducible via benchmarks/<name>/prep.py.
# Kept out of git so gated content (GPQA-Diamond, GAIA) isn't redistributed, and to avoid bloat.
benchmarks/*/tasks.jsonl
# GAIA gated derivatives: staged attachments + the excluded vision/media task records.
benchmarks/gaia/files/
benchmarks/gaia/excluded_vision.jsonl

# GPQA-Diamond and GAIA are gated: their traces embed the verbatim question, so keep
# them out of git too (same reason as tasks.jsonl). MATH traces are fine (public).
camel/traces/*/gpqad_*
camel/traces/*/gaia_*

# stray artifacts downloaded by GAIA run_python tasks (e.g. a 4MB English word list)
words_alpha.txt
